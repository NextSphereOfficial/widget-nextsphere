+# API
+API_PORT=8081
+API_HOST=0.0.0.0
+
+# Observability / Build metadata (set in CI/CD)
+APP_VERSION=0.0.0
+APP_COMMIT=unknown
+APP_BUILD_TIME=1970-01-01T00:00:00Z
+
+# Security
+ENABLE_SECURITY_HEADERS=true
+ENABLE_CSP_REPORT_ONLY=true
+ENABLE_RATE_LIMIT=true
+RATE_LIMIT_MAX=60
+RATE_LIMIT_WINDOW=1 minute
+# CORS: comma-separated origins
+ALLOWED_ORIGINS=http://localhost:5173,https://widget.svapartments.it,https://admin.svapartments.it
+CSP_REPORT_URI=/csp-report
+
+# Sentry (optional)
+SENTRY_DSN=
+SENTRY_TRACES_SAMPLE_RATE=0.0
--- .github/workflows/ci.yml (new)

+++ .github/workflows/ci.yml

@@ -0,0 +1,29 @@

+name: CI
+
+on:
+  push:
+    branches: [ main, staging ]
+    tags: ['v*.*.*']
+  pull_request:
+    branches: [ main, staging ]
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: pnpm/action-setup@v4
+        with:
+          version: 9
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+          cache: 'pnpm'
+      - run: pnpm install --frozen-lockfile=false
+      - name: Set build env
+        run: |
+          echo "APP_VERSION=${ github.ref_name }" >> $GITHUB_ENV
+          echo "APP_COMMIT=$(git rev-parse --short HEAD)" >> $GITHUB_ENV
+          echo "APP_BUILD_TIME=$(date -u +"%Y-%m-%dT%H:%M:%SZ")" >> $GITHUB_ENV
+      - name: Build API
+        run: pnpm --filter @ns/api build
