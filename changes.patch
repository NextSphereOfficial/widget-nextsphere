+const http = require('node:http');
+http.get('http://localhost:8081/health', res => {
+  let chunk=''; res.on('data', d=> chunk+=d);
+  res.on('end', ()=> { try{ console.log(JSON.stringify(JSON.parse(chunk), null, 2)); } catch { console.log(chunk) } });
+}).on('error', e => console.error(e));
