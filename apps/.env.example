# =========================
# API base
# =========================
API_PORT=8081
API_HOST=0.0.0.0

# =========================
# Observability / Build metadata
# (iniettate in CI oppure settate manualmente)
# =========================
APP_VERSION=0.0.0
APP_COMMIT=unknown
APP_BUILD_TIME=1970-01-01T00:00:00Z

# =========================
# Security / CORS
# =========================
ENABLE_SECURITY_HEADERS=true
ENABLE_CSP_REPORT_ONLY=true
# Endpoint che riceve i report
CSP_REPORT_URI=/csp-report

# CORS: lista separata da virgola
ALLOWED_ORIGINS=http://localhost:5173,https://widget.svapartments.it,https://admin.svapartments.it

# =========================
# Rate limit
# =========================
ENABLE_RATE_LIMIT=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute

# =========================
# Sentry (opzionale)
# =========================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
