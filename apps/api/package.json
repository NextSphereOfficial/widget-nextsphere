{
  "name": "@ns/api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "cross-env API_PORT=8081 API_HOST=0.0.0.0 tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "fix:intents": "tsx scripts/fix-intents-core.ts",
    "new:intent": "tsx scripts/new-intent.ts",
    "fmt:yaml": "prettier --write \"src/**/*.yaml\"",
    "lint:yaml": "tsx scripts/validate-yaml.ts",
        "report:intents": "tsx scripts/report-intents.ts",
    "check:content": "pnpm lint:yaml && pnpm report:intents",
    "report:llm": "tsx scripts/report-llm.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^8.0.0",
    "@sentry/node": "^10.22.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.2.3",
    "fastify": "^4.28.1",
    "pino": "^9.14.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.23",
    "cross-env": "^7.0.3",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.7",
    "shx": "^0.3.4"
  },
  "engines": {
    "node": ">=18"
  }
}
