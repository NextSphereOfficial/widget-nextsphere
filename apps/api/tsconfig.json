{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],             // niente "vitest/globals"
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "test",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}

