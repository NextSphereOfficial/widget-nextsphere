{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",                 // <-- fix
    "moduleResolution": "Node16",       // <-- fix
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "types": ["node"],
    "rootDir": ".",                     // include anche /scripts
    "outDir": "dist",
    "allowSyntheticDefaultImports": true

  },
  "include": ["src", "scripts"]
}
